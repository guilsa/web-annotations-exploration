{
  "manifest_version": 3,
  "name": "Textmarker B — Pairshare",
  "version": "0.4.0",
  "description": "Highlight text, open comment threads and edit suggestions in a sidebar, and sync them live with another browser over a direct WebRTC connection (copy-paste invite, no server).",
  "browser_specific_settings": {
    "gecko": {
      "id": "textmarker-b@revamped.local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "permissions": ["storage", "activeTab"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Textmarker B — pair / panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "comment-selection": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "Comment on the current selection"
    },
    "toggle-comments-sidebar": {
      "suggested_key": { "default": "Alt+L", "mac": "Alt+L" },
      "description": "Open / close the comments & suggestions sidebar"
    },
    "toggle-pair-panel": {
      "suggested_key": { "default": "Alt+P", "mac": "Alt+P" },
      "description": "Open the Pairshare panel (invite / join)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-shim.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor.html", "editor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
